# Moybyte Zero board fragment (ESP32-C3, mainline build).
#
# This file is the ONE store of every ESP-IDF setting this repo decided for the
# C3 Zero, prose included; `moybyte_sdkconfig_guard` derives its required
# options from it. The XIAO's fragment
# (firmware/seeed_xiao_esp32s3_zero/boards/MOYBYTE_ZERO/sdkconfig.board) is the
# reference: a line taken from it keeps its reason there, and what is written
# here is what the C3 decides on its own.
#
# Under it, MicroPython's ESP32_GENERIC_C3 fragments (mpconfigboard.cmake):
# sdkconfig.base, sdkconfig.riscv (size optimisation: RISC-V code is larger
# than Xtensa's) and the C3's USB fragment (the v0.3 revision floor, and the
# hardware stack guard off for ESP-IDF issue 14456). The flash is the base's
# 4 MB at the chip's default mode and speed.

# THE PARTITION TABLE: one factory slot and the store. The CSV has the
# arithmetic and board.toml why there is no second slot.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-moybyte-c3-zero.csv"

# No core dump: the table has no coredump partition (the XIAO's reason).
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y

# NOT TAKEN from the XIAO: its WiFi/lwIP window set (64 KB TCP windows, 64
# dynamic buffers each way) and CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC. The XIAO's
# set is RAM-positive only because CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP moves
# those buffers into PSRAM, and mbedTLS's external allocator is PSRAM's; this
# chip has none, so every buffer is internal (WIFI'S RECEIVE RING below).

# THE USB CONSOLE: USB-Serial/JTAG as the PRIMARY console, which is what gives
# esptool a reset it can use (the XIAO's reason, 2026-08-30).
CONFIG_ESP_CONSOLE_UART_DEFAULT=
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Power management off: nothing in this repo touches the PM API (the XIAO's
# reason).
CONFIG_PM_ENABLE=

# Drivers with no caller here, flash this one slot pays for (the XIAO's
# reasons): Ethernet and WPA2/3-Enterprise.
CONFIG_ETH_USE_SPI_ETHERNET=
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=

# NTP asks the moment the station has an address (the XIAO's reason).
CONFIG_LWIP_SNTP_STARTUP_DELAY=n

# IRAM TO FLASH. On this chip IRAM and DRAM split one SRAM at link time, so
# code kept out of IRAM is heap. FreeRTOS's, the heap's and the ring buffer's
# non-ISR functions and newlib's locks run from flash: nothing in this image
# calls them from an ISR while the cache is off (the kernel's own IRAM code is
# its panic handler, which calls none). ESP-IDF's ISR halves stay in IRAM, and
# the image gets smaller, not larger (#276 has the numbers).
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_LIBC_LOCKS_PLACE_IN_IRAM=n

# TLS IN THE ONE HEAP. The kernel's client (native/moy_net/moy_net_port.c)
# holds a connection's record buffers only while they are in use: the
# in-buffer a server's records need is made for the handshake and shrunk
# after it, the out-buffer is made per record, and the CA and config data go
# once the chain verified (CONFIG_MBEDTLS_DYNAMIC_*). It keeps no peer
# certificate after the handshake: its verify callback is the only reader.
# The dynamic buffers exclude DTLS, which MicroPython's base turns on for its
# ssl module and nothing in this image speaks.
CONFIG_MBEDTLS_SSL_PROTO_DTLS=n
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
# Its out-buffer is 2 KB where ESP-IDF's is 4: what this image writes over TLS
# is the handshake's messages and a request's head (the http client's,
# native/moy_net/moy_ota.h), and a longer write goes as more records. The
# in-buffer stays 16 KB, the record a server may send whole.
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
# The curves and the renegotiation no peer of this image uses go, which is
# the flash the secure door's server half takes (native/moy_net/moy_tls_srv.c):
# the CA roots are RSA and P-384 (ca_roots.pem), the door's own key P-256, and
# a browser offers P-256 or X25519.
CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n

# THE CA BUNDLE: ca_roots.pem beside this file, the roots the hosts this
# image fetches from chain to, with a backup per CA family (the file names the
# hosts), not ESP-IDF's common bundle: the release's index and assets, the
# moybyte-org/carts index and the site's mirror verify, and a host outside
# those families fails its handshake. The path is from MicroPython's port
# directory, where ESP-IDF resolves it.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_NONE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="../../../../boards/MOYBYTE_C3_ZERO/ca_roots.pem"

# WIFI'S RECEIVE RING: 4 static buffers where ESP-IDF's default is 10, each
# held from the radio's start for good. The 802.11n reorder window (RX_BA_WIN,
# ESP-IDF's 6) stays within twice their count, and the TCP window stays
# ESP-IDF's four segments, so a burst still lands; the dynamic buffers that
# carry a frame up are made per frame.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
# The dynamic buffers each way are made per frame (about 1.6 KB each) and
# held until lwIP or the radio is done with it, so their most is the peak a
# burst can take of this heap: 12 each way where ESP-IDF's is 32 (51 KB). A
# connection's window is four segments either way (above), and the page
# holds two or three at once, so twelve carry what the windows let fly;
# Espressif's own smallest set for this chip is six each way (the Wi-Fi
# guide's "Minimum" rank, its reorder window 6 over 3 static buffers).
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12

# A CLOSED CONNECTION'S BLOCK GOES BACK IN SECONDS: lwIP keeps a closed TCP
# connection's control block (208 bytes of this one heap) for twice the
# maximum segment lifetime, two minutes at ESP-IDF's 60 s. A page's visit
# closes a dozen, each made while that visit's larger buffers were live, so
# for those two minutes they sat in the middle of the heap's free run. 5 s
# is far past any segment's life on the networks this board serves.
CONFIG_LWIP_TCP_MSL=5000

# SOCKETS FOR THE SECURE DOOR: an https connection is three sockets (the
# browser's, the loopback to the webhost and the webhost's end of it,
# native/moy_net/moy_tls_srv.c), so the live socket and the terminal over
# https with a request beside them pass ESP-IDF's ten. A socket slot is a few
# dozen static bytes; its connection is made per use.
CONFIG_LWIP_MAX_SOCKETS=16

# SYSTEM TASK STACKS: esp_timer's, FreeRTOS's timer service's, the idle
# task's and mDNS's, each sized to its high-water mark under #276's session
# with at least three quarters of a KB over it, and more than twice it (#276
# has both). The event loop's, lwIP's and the WiFi driver's stay ESP-IDF's:
# the station's handler writes NVS on the first.
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2560
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=1536
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=1024
CONFIG_MDNS_TASK_STACK_SIZE=3072

# --- Left out (the XIAO's reasons) -------------------------------------------
CONFIG_LWIP_PPP_SUPPORT=n
CONFIG_LWIP_PPP_PAP_SUPPORT=n
CONFIG_LWIP_PPP_CHAP_SUPPORT=n
CONFIG_LOG_MAXIMUM_LEVEL_INFO=n
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
