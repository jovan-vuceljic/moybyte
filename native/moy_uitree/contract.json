{
 "spec": "ui_api_spec_2026-11.md revision 4",
 "about": "The UI API's contract as data: every error code (§25.2), node kind and prop (§7), takes= value (§5.4), role (§13.1), retired name (§7.9), app field (§19.1) and system value (§14). Both reference layers are tested against it (tests/test_uitree_contract.py). Every entry is built; a layer's gaps are known.json's.",
 "types": {
  "tpl": "a template",
  "cond": "a condition",
  "name": "a declared name (state, model, row_of, unit)",
  "action": "an action",
  "hook": "a hook",
  "action|hook": "an action or a hook",
  "int": "an int",
  "bool": "a bool",
  "list": "a list",
  "lit": "a literal",
  "fn": "a function",
  "key": "a node's key",
  "table": "a label table",
  "takes": "a takes= value",
  "text": "a literal text",
  "word:A,B": "one of the words",
  "list:T": "a list of T",
  "conds": "a condition a value (a dict in Python, a table in Lua)",
  "list|conds": "a list, or one a value (a dict in Python, a table in Lua)",
  "int|word:A,B": "an int, or one of the words",
  "int|name": "an int, or a declared name of an int state"
 },
 "common_props": {
  "shown": {
   "type": "cond",
   "level": 1
  }
 },
 "child_props": {
  "span": "a grid's child (§7.6)",
  "grow": "a row's child (§7.1)"
 },
